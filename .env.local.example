# ─── BDD ──────────────────────────────────────────────────────────
# Neon Postgres. Pour Vercel serverless, ajouter ?pgbouncer=true&connection_limit=1
DATABASE_URL=

# ─── Auth.js v5 ───────────────────────────────────────────────────
# Genere via: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique de l'app (ex: http://localhost:3000 en dev, URL Vercel en preview/prod)
NEXTAUTH_URL=

# ─── Stripe (Sprint 3+) ───────────────────────────────────────────
# En dev : sk_test_xxx / pk_test_xxx / whsec_xxx genere par Stripe CLI
# (cf. docs/manual-testing.md section Sprint 3). En prod : ajout des
# clefs live au Sprint 6 Launch via Vercel env Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Web Push (Sprint 5) ──────────────────────────────────────────
# Genere via: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@devisrapide.fr

# ─── Resend (Sprint 1+) ───────────────────────────────────────────
# Si RESEND_API_KEY est vide en dev, l'envoi d'email tombe en console.log.
# Au S1 on utilise onboarding@resend.dev (DNS pas encore configuré).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Upstash Redis - Rate limiting (Sprint 1+) ────────────────────
# Si les deux variables sont vides, le rate limit tombe en no-op (utile en dev local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (Sprint 5+) ───────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Cron (Sprint 4) ──────────────────────────────────────────────
# Genere via: openssl rand -hex 32
CRON_SECRET=

# ─── Admin seed (Sprint 0) ────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
