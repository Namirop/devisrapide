# ─── BDD ──────────────────────────────────────────────────────────
# Neon Postgres. Deux URLs de la MEME base, et les deux sont obligatoires
# (schema.prisma declare `url` + `directUrl`) :
#   DATABASE_URL = endpoint POOLE, utilise au runtime. Sur Vercel serverless,
#                  ajouter ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = endpoint DIRECT (hostname sans `-pooler`), utilise par
#                  `prisma migrate` et le seed : une migration ne passe pas
#                  par un pooler transactionnel.
# En local, les deux peuvent pointer le meme endpoint direct.
DATABASE_URL=
DIRECT_URL=

# ─── Auth.js v5 ───────────────────────────────────────────────────
# Genere via: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique de l'app (ex: http://localhost:3000 en dev, URL Vercel en preview/prod)
NEXTAUTH_URL=
# Set a "true" UNIQUEMENT pour tester `pnpm start` en local (next start
# mode prod). Auth.js v5 exige sinon un host explicitement trusted et
# rejette les requetes /api/auth/* avec UntrustedHost. En `pnpm dev`,
# inutile (dev mode auto-trust). En Vercel, inutile aussi (auto-trust
# via VERCEL_URL). Ne jamais committer en prod self-host sans reverse
# proxy verifie : ouvrir host-header injection sinon.
AUTH_TRUST_HOST=

# ─── Stripe (Sprint 3+) ───────────────────────────────────────────
# En dev : sk_test_xxx + whsec_xxx genere par Stripe CLI (cf.
# docs/manual-testing.md section Sprint 3). En prod : clefs live via
# Vercel env Production.
#
# Pas de clef publishable : le paiement passe par Stripe Checkout hebergé
# (redirection), aucun Stripe.js cote navigateur.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Web Push (Sprint 5) ──────────────────────────────────────────
# Genere via: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@devisrapide.be

# ─── Resend (Sprint 1+) ───────────────────────────────────────────
# Si RESEND_API_KEY est vide en dev, l'envoi d'email tombe en console.log.
#
# RESEND_FROM_EMAIL : onboarding@resend.dev est le domaine bac-à-sable de
# Resend (n'envoie qu'à ta propre adresse vérifiée + flag spam côté
# destinataire). PROD : vérifier devisrapide.be dans Resend → Domains
# (ajouter les DNS DKIM + SPF + DMARC fournis dans la zone OVH ; NE PAS
# toucher aux MX racine qui servent le webmail OVH contact@devisrapide.be),
# puis passer RESEND_FROM_EMAIL="DevisRapide <contact@devisrapide.be>".
# C'est le principal levier anti-spam (bien avant le visuel des emails).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Upstash Redis - Rate limiting (Sprint 1+) ────────────────────
# Si les deux variables sont vides, le rate limit tombe en no-op (utile en dev local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Alerting ops - Better Stack ──────────────────────────────────
# URL du heartbeat Better Stack (elle contient le token, a traiter comme
# un secret). Deux usages : le cron process-leads la ping a la fin d'un
# run propre, et reportIncident() ping <URL>/fail sur une panne.
# Plusieurs URLs separees par des virgules = plusieurs comptes prevenus
# (l'offre gratuite ne garantit pas les membres d'equipe).
# Si absente : no-op silencieux (dev local, CI).
BETTERSTACK_HEARTBEAT_URL=

# Destinataires de l'alerte "quota d'emails bientot atteint" (60/100 sur
# l'offre gratuite Resend), separes par des virgules. Si absente :
# l'alerte n'est pas envoyee, seul l'incident au depassement reste.
ALERT_EMAIL=

# ─── Cloudflare Turnstile (Sprint 5c) ─────────────────────────────
# Anti-bot CAPTCHA invisible sur 3 formulaires (wizard /demande,
# inscription pro, login). Recuperer via Cloudflare dashboard >
# Turnstile > Add site.
# En dev sans keys : verifyTurnstileToken renvoie success=true si
# le token vaut "mock" (cf. src/lib/turnstile/verify.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Cron (Sprint 4) ──────────────────────────────────────────────
# Genere via: openssl rand -hex 32
CRON_SECRET=

# ─── Admin seed (Sprint 0) ────────────────────────────────────────
# Admin principal (Kamel en prod).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ─── Launch protection (verrou par cookie) ────────────────────────
# Verrou temporaire pour masquer le site au public jusqu'au launch
# officiel. Gere dans src/proxy.ts + src/lib/launch-protect.ts.
# Alternative gratuite au password protect natif Vercel.
#
# Mecanisme : page /acces qui pose un cookie httpOnly longue duree (90j)
# apres saisie des identifiants. PAS de HTTP Basic Auth (casse en PWA iOS
# standalone : WebKit ne reaffiche pas la popup au relancement → ecran
# bloque). La redirection + cookie marche sur toutes les plateformes.
#
# LAUNCH_PROTECT_ENABLED : "true" => le site exige le cookie sur toutes
#   les routes (redirige vers /acces sinon). Toute autre valeur (ou
#   absent) => site public, aucun effet (no-op).
# LAUNCH_PROTECT_USERNAME / _PASSWORD : identifiants uniques (1 seul
#   compte) saisis sur /acces. Si ENABLED=true mais ces 2 vars manquent
#   => acces bloque (fail-closed).
#
# Restent publics meme verrou actif : /acces, /api/stripe/webhook,
# /api/cron/* (auth propre via signature / CRON_SECRET) et les assets
# statiques (deja hors middleware via le matcher).
#
# Toggle sans toucher au code : changer la var sur Vercel + redeploy.
# Au launch => LAUNCH_PROTECT_ENABLED=false (ou supprimer la var).
LAUNCH_PROTECT_ENABLED=
LAUNCH_PROTECT_USERNAME=
LAUNCH_PROTECT_PASSWORD=
