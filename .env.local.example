# ─── BDD ──────────────────────────────────────────────────────────
# Neon Postgres. Pour Vercel serverless, ajouter ?pgbouncer=true&connection_limit=1
DATABASE_URL=

# ─── Auth.js v5 ───────────────────────────────────────────────────
# Genere via: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique de l'app (ex: http://localhost:3000 en dev, URL Vercel en preview/prod)
NEXTAUTH_URL=

# ─── Stripe (Sprint 3+) ───────────────────────────────────────────
# En dev : sk_test_xxx / pk_test_xxx / whsec_xxx genere par Stripe CLI
# (cf. docs/manual-testing.md section Sprint 3). En prod : ajout des
# clefs live au Sprint 6 Launch via Vercel env Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Web Push (Sprint 5) ──────────────────────────────────────────
# Genere via: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@devisrapide.fr

# ─── Resend (Sprint 1+) ───────────────────────────────────────────
# Si RESEND_API_KEY est vide en dev, l'envoi d'email tombe en console.log.
# Au S1 on utilise onboarding@resend.dev (DNS pas encore configuré).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Upstash Redis - Rate limiting (Sprint 1+) ────────────────────
# Si les deux variables sont vides, le rate limit tombe en no-op (utile en dev local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (Sprint 5c) ───────────────────────────────────────────
# DSN du projet Sentry. Si absent : Sentry.init est gracefully no-op
# (pas de network, pas d'erreur). enabled=true uniquement en production
# (cf. sentry.{client,server,edge}.config.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Org + project + token pour upload des source maps via withSentryConfig.
# Optionnels : sans SENTRY_AUTH_TOKEN, le upload est skipped silencieusement
# (les captures runtime continuent de fonctionner sans).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Cloudflare Turnstile (Sprint 5c) ─────────────────────────────
# Anti-bot CAPTCHA invisible sur 3 formulaires (wizard /demande,
# inscription pro, login). Recuperer via Cloudflare dashboard >
# Turnstile > Add site.
# En dev sans keys : verifyTurnstileToken renvoie success=true si
# le token vaut "mock" (cf. src/lib/turnstile/verify.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Cron (Sprint 4) ──────────────────────────────────────────────
# Genere via: openssl rand -hex 32
CRON_SECRET=

# ─── Admin seed (Sprint 0 + Sprint 4) ─────────────────────────────
# Admin principal (Kamel en prod).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Admin secondaire optionnel (Sprint 4) : Romain en dev local pour
# intervention technique sur le panel admin. Skipped silencieusement
# si les 2 vars sont absentes (cas typique de la prod).
ADMIN_2_EMAIL=
ADMIN_2_INITIAL_PASSWORD=
ADMIN_2_FIRST_NAME=

# ─── Seed fakes (dev only) ────────────────────────────────────────
# Active la generation de users/leads/transactions de test au prochain
# `prisma db seed`. Idempotent (purge les enregistrements .test@example.test
# avant recreation). NE JAMAIS definir en env Vercel production.
SEED_FAKES=
