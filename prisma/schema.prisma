generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS & AUTH ──────────────────────────────────────────

enum UserRole {
  CLIENT
  PRO
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  firstName    String?
  lastName     String?
  role         UserRole
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  proProfile       ProProfile?
  leadsAsClient    Lead[]              @relation("ClientLeads")
  assignments      LeadAssignment[]    @relation("ProAssignments")
  walletTxs        WalletTransaction[]
  auditLogsAsActor AuditLog[]          @relation("ActorLogs")
  accounts         Account[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([deletedAt])
}

// Tables Auth.js v5 standard
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Token de reinitialisation de mot de passe pro. Distinct de
// VerificationToken (Auth.js / magic links) : table dediee, liee au User,
// avec usage unique (used) et expiration courte (1h, gere applicativement).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PRO PROFILE ───────────────────────────────────────────

enum ProValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  SUSPENDED
}

model ProProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  vatNumber   String? @unique
  description String? @db.Text

  validationStatus ProValidationStatus @default(PENDING)
  validatedAt      DateTime?
  // Raison rensignee par l'admin lors d'un refus (status REJECTED) via
  // /admin/professionnels + envoyee au pro par email.
  rejectedReason   String?
  // Raison de suspension renseignee par l'admin lors d'un passage en
  // SUSPENDED. Reinitialisee a null lors d'une reactivation.
  suspensionReason String?

  postalCode           String
  city                 String
  latitude             Float
  longitude            Float
  interventionRadiusKm Int    @default(30)

  // Default 100000 cents = 1000€ de credit gratuit a l'inscription V1.
  // Sera remplace par le flow Stripe Checkout.
  walletBalanceCents Int     @default(100000)
  stripeCustomerId   String? @unique

  // V1 : toggle simple ON/OFF. V2 : enrichira en regles fines (par cat,
  // prix max, horaires) plutot que de re-introduire un enum a 3 valeurs.
  autoAccept           Boolean   @default(false)
  // Conserve pour V2 round-robin exclusive (pas consomme en V1).
  lastExclusiveLeadAt  DateTime?
  // Utile dashboard pro (derniere notification recue).
  lastLeadReceivedAt   DateTime?
  notifyByEmail        Boolean   @default(true)
  notifyByPush         Boolean   @default(true)

  pushSubscriptions PushSubscription[]
  categories        ProCategory[]
  assignments       LeadAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationStatus])
  @@index([latitude])
}

model ProCategory {
  proProfileId String
  categoryId   String

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([proProfileId, categoryId])
  @@index([categoryId])
}

model PushSubscription {
  id           String     @id @default(cuid())
  proProfileId String
  proProfile   ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([proProfileId])
}

// ─── CATALOGUE (3 niveaux) ─────────────────────────────────

model Universe {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  iconName     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Restrict)

  name         String
  slug         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  defaultSharedLeadPriceCents    Int
  defaultExclusiveLeadPriceCents Int

  subCategories SubCategory[]
  proCategories ProCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, slug])
  @@index([universeId])
  @@index([isActive])
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name         String
  slug         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  sharedLeadPriceCents    Int?
  exclusiveLeadPriceCents Int?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

// ─── LEADS ─────────────────────────────────────────────────

enum LeadUrgency {
  URGENT
  SOON
  PLANNED
  FLEXIBLE
}

enum LeadStatus {
  PENDING_MATCH
  ASSIGNED
  ACCEPTED
  COMPLETED
  EXPIRED
  CANCELLED
}

model Lead {
  id     String     @id @default(cuid())
  status LeadStatus @default(PENDING_MATCH)

  // onDelete: Restrict — un User CLIENT avec des Leads ne peut pas etre
  // hard-deleted (soft delete only, voir User.deletedAt). Defense en
  // profondeur explicite (default Prisma = NoAction ~= Restrict mais
  // implicite, on prefere voir l'intention au schema).
  clientId String
  client   User   @relation("ClientLeads", fields: [clientId], references: [id], onDelete: Restrict)

  clientFirstName String
  clientLastName  String
  clientEmail     String
  clientPhone     String

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)

  description String      @db.Text
  urgency     LeadUrgency

  postalCode String
  city       String
  address    String?
  latitude   Float
  longitude  Float

  isExclusive Boolean @default(false)

  sharedLeadPriceCentsSnapshot    Int
  exclusiveLeadPriceCentsSnapshot Int

  currentRadiusKm Int @default(30)
  matchAttempts   Int @default(0)

  // Timestamp de la 1ere passe de matching, utilise par le cron
  // d'elargissement de zone (palier 2 a +2h, OPEN a +4h, timeout +24h).
  matchingStartedAt DateTime?

  // Timestamp de l'envoi de l'email "no-match 24h"
  // au client. NULL = jamais envoye. Le cron daily
  // check-no-match-leads le set apres envoi pour eviter les doublons.
  noMatchNotifiedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  assignments LeadAssignment[]

  @@index([status])
  @@index([subCategoryId, status])
  @@index([latitude])
  @@index([createdAt])
  @@index([deletedAt])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
}

// Qualification post-acceptation, distincte du cycle d'acceptation
// (AssignmentStatus). PENDING tant que le pro n'a pas qualifie.
enum LeadFollowupStatus {
  PENDING
  CONVERTED
  NO_FOLLOWUP
  NOT_REACHABLE
}

model LeadAssignment {
  id           String @id @default(cuid())
  leadId       String
  proProfileId String
  proUserId    String

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  // onDelete: Restrict — empeche le hard-delete d'un User PRO qui a des
  // assignments (cf. soft delete only sur User).
  proUser    User       @relation("ProAssignments", fields: [proUserId], references: [id], onDelete: Restrict)

  status         AssignmentStatus   @default(PENDING)
  followupStatus LeadFollowupStatus @default(PENDING)
  isExclusive    Boolean            @default(false)
  priceCents     Int

  // Rayon utilise au moment de la creation de l'assignment (30, 60 ou -1
  // pour OPEN). Permet de tracer dans quel palier le pro a ete matche.
  radiusKmAtAssignment Int @default(30)

  notifiedAt  DateTime  @default(now())
  // Timestamps separes pour accept vs refus. acceptedAt declenche
  // le debit wallet et l'email "lead accepte". refusedAt enregistre le refus
  // (sans email au pro). refusalReason optionnel via Server Action.
  acceptedAt     DateTime?
  refusedAt      DateTime?
  refusalReason  String?
  expiresAt      DateTime
  // Timestamp du push "lead bientot expire" envoye par le cron.
  // Garde-fou anti-spam : un meme assignment ne peut etre notifie qu'une
  // seule fois pour expiration imminente (cron tourne tous les 15min).
  expiryNotifiedAt DateTime?

  // Assignment cree par l'admin (action "Offrir un lead").
  // Quand adminGifted = true : status est ACCEPTED direct, priceCents = 0,
  // pas de debit wallet, pas de notification PENDING. adminGiftedBy
  // trace le userId de l'admin pour audit minimal.
  // adminGiftNote separe du refusalReason (avant : overload
  // hacky sur refusalReason pour stocker la note admin).
  adminGifted   Boolean @default(false)
  adminGiftedBy String?
  adminGiftNote String?

  walletTransactionId String?            @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  @@unique([leadId, proProfileId])
  @@index([proProfileId, status])
  @@index([status, expiresAt])
  @@index([adminGifted])
}

// ─── WALLET ────────────────────────────────────────────────

enum WalletTxType {
  TOPUP
  LEAD_DEBIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  REFUND_TO_CREDIT
}

model WalletTransaction {
  id     String @id @default(cuid())
  // onDelete: Restrict — un User avec des WalletTransaction (historique
  // financier immuable) ne peut pas etre hard-deleted. Soft delete only.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type              WalletTxType
  amountCents       Int
  balanceAfterCents Int

  // Pour les TOPUP, montant reellement paye par le pro (hors
  // bonus) + bonus offert, snapshotes a la recharge pour les factures B2B
  // manuelles mensuelles (cf. /admin/finances). amountCents reste le total
  // credite (paye + bonus). NULL sur les transactions anterieures
  // ou non-TOPUP → affichage "—" dans le recap.
  amountPaidCents   Int?
  bonusCents        Int?

  // Tracage des recharges Stripe Checkout. Le PaymentIntent
  // est l'identifiant cote Stripe pour le paiement effectif, la Checkout
  // Session est l'identifiant cote produit (1 session = 1 PI en V1
  // payment-mode one-time). Les deux sont @unique pour garantir qu'aucune
  // transaction TOPUP n'est ecrite 2x pour la meme operation Stripe meme
  // si le webhook handler venait a etre rejoue hors de l'idempotence
  // par StripeWebhookEvent.
  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String? @unique

  leadAssignmentId String?
  assignment       LeadAssignment?

  adminReason  String?
  adminActorId String?

  description String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

// Log immuable des webhooks Stripe traites, indispensable pour
// l'idempotence du handler /api/stripe/webhook. stripeEventId @unique
// garantit qu'un meme event Stripe (event.id) ne peut etre persiste que
// 1 seule fois → un retry Stripe rebondit sur le unique constraint et
// ne re-credite pas le wallet.
//
// proProfileId est stocke sans relation Prisma pour ne pas creer une
// back-relation lourde sur ProProfile : on requete toujours en partant
// d'un event Stripe, pas l'inverse.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  payload       Json
  processedAt   DateTime @default(now())

  proProfileId String?

  @@index([eventType])
  @@index([processedAt])
  @@index([proProfileId])
}

// ─── AUDIT LOG ─────────────────────────────────────────────

enum AuditAction {
  PRO_VALIDATED
  PRO_REJECTED
  PRO_SUSPENDED
  PRO_REACTIVATED
  PRO_PROFILE_UPDATED
  PRICE_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DEACTIVATED
  WALLET_CREDIT_ADDED
  WALLET_DEBIT_ADDED
  LEAD_CANCELLED
  LEAD_GIFTED
  LEAD_DELETED
  LEAD_CREATION_TOGGLED
  LEAD_SETTINGS_UPDATED
  USER_DELETED
}

// Issue d'execution d'une action admin. Permet de logger les
// tentatives echouees (mauvais input, conflit, etc.) en plus des
// succes — utile pour audit securite (qui a essaye de debit le
// wallet X fois ?).
enum AuditLogStatus {
  SUCCESS
  FAILURE
}

model AuditLog {
  id      String         @id @default(cuid())
  action  AuditAction
  status  AuditLogStatus @default(SUCCESS)
  // onDelete: SetNull — un admin supprime reste loggue dans l'audit
  // historique, mais actor = null. Permet la retention legale (audit
  // immuable) tout en respectant le droit a l'effacement RGPD du User.
  actorId String?
  actor   User?          @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  targetType String
  targetId   String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([status, createdAt])
}

// ─── CONFIG ────────────────────────────────────────────────

model AppConfig {
  key         String   @id
  value       String
  valueType   String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
