generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS & AUTH ──────────────────────────────────────────

enum UserRole {
  CLIENT
  PRO
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  firstName    String?
  lastName     String?
  role         UserRole
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  proProfile       ProProfile?
  leadsAsClient    Lead[]              @relation("ClientLeads")
  assignments      LeadAssignment[]    @relation("ProAssignments")
  walletTxs        WalletTransaction[]
  auditLogsAsActor AuditLog[]          @relation("ActorLogs")
  accounts         Account[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([deletedAt])
}

// Tables standard de l'adaptateur Prisma d'Auth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Réinitialisation du mot de passe pro, distincte de VerificationToken
// (Auth.js) : liée au User, à usage unique, expiration d'1h gérée côté
// application.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PRO PROFILE ───────────────────────────────────────────

enum ProValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  SUSPENDED
}

model ProProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  vatNumber   String? @unique
  description String? @db.Text

  validationStatus ProValidationStatus @default(PENDING)
  validatedAt      DateTime?
  // Motif saisi par l'admin au refus (REJECTED), transmis au pro par email.
  rejectedReason   String?
  // Motif de suspension (SUSPENDED), remis à null à la réactivation.
  suspensionReason String?

  postalCode           String
  city                 String
  latitude             Float
  longitude            Float
  interventionRadiusKm Int    @default(30)

  // Zéro à l'inscription. Ne jamais « offrir » du crédit via cette valeur par
  // défaut : aucun WalletTransaction ne serait créé, le solde divergerait du
  // journal et fausserait le CA de /admin/finances. Un geste commercial passe
  // par l'ajustement manuel admin, qui journalise.
  walletBalanceCents Int     @default(0)
  stripeCustomerId   String? @unique

  autoAccept           Boolean   @default(false)
  // Inutilisée : ni lue ni écrite (la rotation repose sur lastLeadReceivedAt).
  lastExclusiveLeadAt  DateTime?
  // Clé de la rotation équitable du matching (cf. lib/matching/find-pros.ts).
  lastLeadReceivedAt   DateTime?
  notifyByEmail        Boolean   @default(true)
  notifyByPush         Boolean   @default(true)

  pushSubscriptions PushSubscription[]
  categories        ProCategory[]
  assignments       LeadAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationStatus])
  @@index([latitude])
}

model ProCategory {
  proProfileId String
  categoryId   String

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([proProfileId, categoryId])
  @@index([categoryId])
}

model PushSubscription {
  id           String     @id @default(cuid())
  proProfileId String
  proProfile   ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([proProfileId])
}

// ─── CATALOGUE (3 niveaux) ─────────────────────────────────

model Universe {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  iconName     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Restrict)

  name         String
  slug         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  // Catégorie « fourre-tout » (univers Autre). Ses leads échappent à deux
  // règles du matching :
  //   1. pas de filtre d'abonnement : tout pro validé de la zone les reçoit,
  //      personne ne s'abonnant à « Autre » ;
  //   2. jamais d'auto-accept : débiter automatiquement un pro pour une
  //      demande hors de son métier serait un débit non consenti.
  // Un flag en base plutôt qu'un slug en dur : pas de déploiement pour en
  // ajouter une autre.
  isCatchAll Boolean @default(false)

  defaultSharedLeadPriceCents    Int
  defaultExclusiveLeadPriceCents Int

  subCategories SubCategory[]
  proCategories ProCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, slug])
  @@index([universeId])
  @@index([isActive])
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name         String
  slug         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  sharedLeadPriceCents    Int?
  exclusiveLeadPriceCents Int?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

// ─── LEADS ─────────────────────────────────────────────────

enum LeadUrgency {
  URGENT
  SOON
  PLANNED
  FLEXIBLE
}

enum LeadStatus {
  PENDING_MATCH
  ASSIGNED
  ACCEPTED
  COMPLETED
  EXPIRED
  CANCELLED
}

model Lead {
  id     String     @id @default(cuid())
  status LeadStatus @default(PENDING_MATCH)

  // Restrict explicite (plutôt que le NoAction implicite) : un client ayant
  // des leads ne peut pas être supprimé physiquement (soft delete uniquement).
  clientId String
  client   User   @relation("ClientLeads", fields: [clientId], references: [id], onDelete: Restrict)

  clientFirstName String
  clientLastName  String
  clientEmail     String
  clientPhone     String

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)

  description String      @db.Text
  urgency     LeadUrgency

  postalCode String
  city       String
  address    String?
  latitude   Float
  longitude  Float

  isExclusive Boolean @default(false)

  sharedLeadPriceCentsSnapshot    Int
  exclusiveLeadPriceCentsSnapshot Int

  currentRadiusKm Int @default(30)

  // Inutilisée (ni lue ni écrite), conservée pour éviter une migration
  // destructive : le nombre d'assignments se compte sur LeadAssignment.
  matchAttempts   Int @default(0)

  // Première passe de matching : point de départ de l'élargissement de zone
  // (ZONE_EXPANSION_DELAYS_MIN / RADIUS_PALIERS_KM dans AppConfig).
  matchingStartedAt DateTime?

  // Envoi de l'email « aucun pro sous 24h » au client, posé par le cron
  // quotidien check-no-match-leads pour ne l'envoyer qu'une fois.
  noMatchNotifiedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  assignments LeadAssignment[]

  @@index([status])
  @@index([subCategoryId, status])
  @@index([latitude])
  @@index([createdAt])
  @@index([deletedAt])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
}

// Qualification post-acceptation, distincte du cycle d'acceptation
// (AssignmentStatus). PENDING tant que le pro n'a pas qualifié le lead.
enum LeadFollowupStatus {
  PENDING
  CONVERTED
  NO_FOLLOWUP
  NOT_REACHABLE
}

model LeadAssignment {
  id           String @id @default(cuid())
  leadId       String
  proProfileId String
  proUserId    String

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  // Restrict : pas de suppression physique d'un pro ayant des assignments.
  proUser    User       @relation("ProAssignments", fields: [proUserId], references: [id], onDelete: Restrict)

  status         AssignmentStatus   @default(PENDING)
  followupStatus LeadFollowupStatus @default(PENDING)
  isExclusive    Boolean            @default(false)
  priceCents     Int

  // Palier de rayon au moment du matching (30, 60 ou -1 pour OPEN).
  radiusKmAtAssignment Int @default(30)

  notifiedAt  DateTime  @default(now())
  acceptedAt     DateTime?
  refusedAt      DateTime?
  refusalReason  String?
  expiresAt      DateTime
  // Push « lead bientôt expiré » déjà envoyé : le cron (toutes les 15 min)
  // ne notifie qu'une fois par assignment.
  expiryNotifiedAt DateTime?

  // Lead offert par l'admin : ACCEPTED d'emblée, priceCents = 0, sans débit.
  // adminGiftedBy = userId de l'admin, adminGiftNote = note libre.
  adminGifted   Boolean @default(false)
  adminGiftedBy String?
  adminGiftNote String?

  walletTransactionId String?            @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  @@unique([leadId, proProfileId])
  @@index([proProfileId, status])
  @@index([status, expiresAt])
  @@index([adminGifted])
}

// ─── WALLET ────────────────────────────────────────────────

enum WalletTxType {
  TOPUP
  LEAD_DEBIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  REFUND_TO_CREDIT
}

model WalletTransaction {
  id     String @id @default(cuid())
  // Restrict : l'historique financier est immuable, pas de suppression
  // physique d'un utilisateur qui en possède.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type              WalletTxType
  amountCents       Int
  balanceAfterCents Int

  // TOPUP : part payée et bonus, figés à la recharge pour la facturation
  // (cf. /admin/finances). amountCents reste le total crédité. NULL hors
  // TOPUP, affiché « — ».
  amountPaidCents   Int?
  bonusCents        Int?

  // Recharges Stripe Checkout (mode payment : une session = un PaymentIntent).
  // @unique : filet contre une double écriture TOPUP, en plus de
  // l'idempotence assurée par StripeWebhookEvent.
  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String? @unique

  leadAssignmentId String?
  assignment       LeadAssignment?

  adminReason  String?
  adminActorId String?

  description String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

// Journal immuable des webhooks Stripe traités : stripeEventId @unique rend
// /api/stripe/webhook idempotent (un retry Stripe bute sur la contrainte et
// ne recrédite pas le wallet). proProfileId sans relation Prisma : les
// lectures partent toujours de l'événement.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  payload       Json
  processedAt   DateTime @default(now())

  proProfileId String?

  @@index([eventType])
  @@index([processedAt])
  @@index([proProfileId])
}

// ─── AUDIT LOG ─────────────────────────────────────────────

enum AuditAction {
  PRO_VALIDATED
  PRO_REJECTED
  PRO_SUSPENDED
  PRO_REACTIVATED
  PRO_PROFILE_UPDATED
  PRICE_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DEACTIVATED
  WALLET_CREDIT_ADDED
  WALLET_DEBIT_ADDED
  // Jamais émis : l'annulation admin est un soft delete, tracé par LEAD_DELETED.
  LEAD_CANCELLED
  LEAD_GIFTED
  LEAD_DELETED
  LEAD_CREATION_TOGGLED
  LEAD_SETTINGS_UPDATED
  // Jamais émis. Limite connue : la suppression de compte n'existe pas, aucun
  // code ne pose User.deletedAt et les guards de session ne le filtrent pas.
  USER_DELETED
}

// Issue d'une action admin : les échecs (entrée invalide, conflit…) sont
// journalisés au même titre que les succès, pour l'audit de sécurité.
enum AuditLogStatus {
  SUCCESS
  FAILURE
}

model AuditLog {
  id      String         @id @default(cuid())
  action  AuditAction
  status  AuditLogStatus @default(SUCCESS)
  // SetNull : l'audit survit à la suppression de l'admin (rétention) tout en
  // respectant le droit à l'effacement (RGPD).
  actorId String?
  actor   User?          @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  targetType String
  targetId   String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([status, createdAt])
}

// ─── CONFIG ────────────────────────────────────────────────

model AppConfig {
  key         String   @id
  value       String
  valueType   String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
